{
  "id": "fuentes-de-onoro",
  "name": "Fuentes de Oñoro",
  "date": "3–5 May 1811",
  "campaign": "peninsular-war",
  "summary": "Masséna came back to relieve Almeida and found Wellington across his road at the village of Fuentes de Oñoro. Two days of fighting in its walled lanes left it in British hands; on the 5th Masséna swung round the open southern flank, and the 7th and Light Divisions fell back across the plain in squares through Montbrun's cavalry. Wellington held the shortened line, and Masséna withdrew: 'if Boney had been there, we should have been beat'.",
  "sources": [
    {
      "label": "Anglo-Portuguese Army at Fuentes de Onoro, 3–5 May 1811 (Nafziger Collection 811ESAG)",
      "url": "https://www.napoleon-series.org/nafzigger/811ESAG.pdf"
    },
    {
      "label": "French Army at Fuentes de Onoro, 3–5 May 1811 (Nafziger Collection 811ESAH)",
      "url": "https://www.napoleon-series.org/nafzigger/811ESAH.pdf"
    },
    {
      "label": "Battle of Fuentes de Oñoro (Wikipedia)",
      "url": "https://en.wikipedia.org/wiki/Battle_of_Fuentes_de_O%C3%B1oro"
    }
  ],
