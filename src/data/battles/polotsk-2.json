{
  "id": "polotsk-2",
  "name": "Second Polotsk",
  "date": "18–20 October 1812",
  "campaign": "russia-1812",
  "summary": "Reinforced by Steinheil's Finland Corps, Wittgenstein came back against Saint-Cyr's worn-down French and Bavarians at Polotsk. His columns stormed the entrenchments before the town on the 18th, and as Steinheil crossed the Dvina to come in from the south Saint-Cyr, wounded, gave the town up in the night of the 19th after fierce street fighting, retreating with the threat to the Grande Armée's line of retreat now real.",
  "sources": [
    {
      "label": "French II Corps, 15 September 1812 (Nafziger Collection 812ICD)",
      "url": "https://www.napoleon-series.org/nafzigger/812ICD.pdf"
    },
    {
      "label": "Bavarian VI Corps, 15 September 1812 (Nafziger Collection 812IXA)",
      "url": "https://www.napoleon-series.org/nafzigger/812IXA.pdf"
    },
    {
      "label": "Russian I Corps after joined by the Finland Corps, 16/28 October 1812 (Nafziger Collection 812JCH)",
      "url": "https://www.napoleon-series.org/nafzigger/812JCH.pdf"
    },
    {
      "label": "Second Battle of Polotsk (Wikipedia)",
      "url": "https://en.wikipedia.org/wiki/Second_Battle_of_Polotsk"
    }
  ],
