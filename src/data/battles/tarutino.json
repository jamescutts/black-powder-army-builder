{
  "id": "tarutino",
  "name": "Tarutino",
  "date": "18 October 1812",
  "campaign": "russia-1812",
  "summary": "While Napoleon waited in Moscow for a peace that never came, Murat's advance guard sat facing Kutuzov's camp at Tarutino. Bennigsen struck it at dawn: Orlov-Denisov's Cossacks burst into Sébastiani's camp, but the infantry columns lost their way in the woods and came up late, and Murat got his men away with the loss of 2,500 men and three dozen guns. Next day Napoleon left Moscow.",
  "sources": [
    {
      "label": "Russian Army, Battle of Borodino, 5–7 September 1812 (Nafziger Collection 812ICB)",
      "url": "https://www.napoleon-series.org/nafzigger/812ICB.pdf"
    },
    {
      "label": "French Army, Battle of Borodino, 5–7 September 1812 (Nafziger Collection 812ICA)",
      "url": "https://www.napoleon-series.org/nafzigger/812ICA.pdf"
    },
    {
      "label": "Battle of Tarutino (Wikipedia)",
      "url": "https://en.wikipedia.org/wiki/Battle_of_Tarutino"
    }
  ],
  "forces": [
