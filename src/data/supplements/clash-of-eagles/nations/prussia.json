  "brigades": [
    {
      "id": "pr-infantry-brigade",
      "name": "Infantry Brigade",
      "min": 1,
      "max": 6,
      "slots": [
        {
          "label": "Musketeer Battalion (1-2 per regiment, 1-2 regiments per brigade)",
          "unitIds": [
            "pr-musketeer",
            "pr-guard-musketeer"
          ],
          "min": 1,
          "max": 4
        },
        {
          "label": "Fusilier Battalion (0-1 per regiment, optional)",
          "unitIds": [
            "pr-fusilier",
            "pr-guard-fusilier"
          ],
          "min": 0,
          "max": 2
        },
        {
          "label": "Attached Jäger Battalion (optional, brigade support)",
          "unitIds": [
            "pr-jager"
          ],
          "min": 0,
          "max": 1
        },
        {
          "label": "Attached Dragoon Regiment (optional, brigade support, 1 per army)",
          "unitIds": [
            "pr-dragoon"
          ],
          "min": 0,
          "max": 1,
          "unitCaps": [
            {
              "unitId": "pr-dragoon",
              "armyMax": 1
            }
          ]
        },
        {
          "label": "Attached Hussar Regiment (optional, brigade support, 1 per army)",
          "unitIds": [
            "pr-hussars"
          ],
          "min": 0,
          "max": 1,
          "unitCaps": [
            {
              "unitId": "pr-hussars",
              "armyMax": 1
            }
          ]
        },
        {
          "label": "Foot Artillery Battery (optional, if 6+ battalions taken)",
          "unitIds": [
            "pr-foot-arty-half",
            "pr-foot-arty"
          ],
          "min": 0,
          "max": 1
        }
      ],
      "commanderUnitId": "pr-brig-cmd",
      "note": "Brigade Support is ONE choice of Jäger, Dragoon or Hussar per brigade (not enforced structurally — pick only one)"
