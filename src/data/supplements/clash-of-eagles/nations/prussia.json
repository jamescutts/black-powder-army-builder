            "pr-heavy-arty-half",
            "pr-heavy-arty",
            "pr-foot-arty-half",
            "pr-foot-arty",
            "pr-horse-arty-half",
            "pr-horse-arty"
          ],
          "min": 1,
          "max": 1
        }
      ],
      "note": "Up to 1 Heavy battery (if 3 brigades taken), up to 2 Foot batteries (1 per 2 brigades), up to 1 Horse battery (if 3 brigades taken). A brigade can carry no more than 2 batteries."
    }
