# Community Lists are unofficial/fan-made army lists, hidden by default.
# Set to "true" to show them (e.g. in a preview/staging environment).
NEXT_PUBLIC_SHOW_COMMUNITY_LISTS=false

# The 1813 (War of Liberation) and 1814 (Campaign in France) historical campaigns are still being
# written and hidden by default. Set to "true" to show them.
NEXT_PUBLIC_SHOW_1813_1814=false

# On Cloudflare Workers these NEXT_PUBLIC_ settings are read when the site is built, so set them as
# build variables (Worker > Settings > Build > Variables and secrets), not as runtime variables.
